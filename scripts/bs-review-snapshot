#!/usr/bin/env bash
set -euo pipefail

# Helper for pre/post review working-tree snapshot verification in bs-review.
# Commands: begin | untracked <state-dir> | verify <state-dir> | cleanup <state-dir>

usage() {
  cat >&2 <<'EOF'
Usage: bs-review-snapshot <command> [args...]
  begin                  Capture pre-review state in a temp dir and print its path
  untracked <state-dir>  Print pre-review untracked file list, or "none" if empty
  verify <state-dir>     Compare current tree against pre-review state; exit 1 with report on mismatch
  cleanup <state-dir>    Delete the temporary review state directory
EOF
  exit 2
}

[ $# -ge 1 ] || usage
CMD="$1"
shift

hash_entry() {
  local p="$1"
  if [ -L "$p" ]; then
    printf 'symlink:%s\t%s\n' "$(readlink -- "$p")" "$p"
  elif [ -f "$p" ]; then
    printf 'file:%s\t%s\n' "$(sha256sum -- "$p" | awk '{print $1}')" "$p"
  elif [ -e "$p" ]; then
    printf 'other\t%s\n' "$p"
  else
    printf 'missing\t%s\n' "$p"
  fi
}

hash_untracked() {
  local p
  while IFS= read -r -d '' p; do
    hash_entry "$p"
  done < <(git ls-files --others --exclude-standard -z)
}

# Ignore user diff config (diff.external, textconv, color, submodule ignore settings) so every
# content change shows up.
DIFF_OPTS=(--no-ext-diff --no-textconv --no-color --binary --no-renames --ignore-submodules=none)

# Raw hashes of tracked files whose changes git's diff can hide: assume-unchanged and
# skip-worktree entries, files with a clean filter, and exec bits when core.fileMode=false.
hash_hidden_tracked() {
  local e tag p attr val
  {
    while IFS= read -r -d '' e; do
      tag="${e%% *}"
      p="${e#* }"
      case "$tag" in [a-z]|S) printf '%s\0' "$p" ;; esac
    done < <(git ls-files -v -z)
    while IFS= read -r -d '' p && IFS= read -r -d '' attr && IFS= read -r -d '' val; do
      case "$val" in unspecified|unset) ;; *) printf '%s\0' "$p" ;; esac
    done < <(git ls-files -z | git check-attr -z --stdin filter)
  } | LC_ALL=C sort -zu | while IFS= read -r -d '' p; do
    hash_entry "$p"
  done
  if [ "$(git config --bool --get core.fileMode 2>/dev/null || echo true)" = false ]; then
    while IFS= read -r -d '' p; do
      if [ -f "$p" ] && [ -x "$p" ]; then
        printf 'x\t%s\n' "$p"
      fi
    done < <(git ls-files -z)
  fi
}

# Changes inside submodules (including ones that were already dirty), whatever their ignore setting.
hash_submodules() {
  git submodule foreach --quiet --recursive '
    echo "== $displaypath"
    git status --porcelain --ignore-submodules=none
    git diff --no-ext-diff --no-textconv --no-color --binary --no-renames HEAD 2>/dev/null || true
    git ls-files -z --others --exclude-standard | xargs -0 -r sha256sum -- 2>/dev/null || true
  ' 2>/dev/null || true
}

compute_snapshot() {
  local repo_root="$1"
  cd "$repo_root"
  {
    git status --porcelain --ignore-submodules=none
    if git rev-parse --verify --quiet HEAD >/dev/null; then
      git diff "${DIFF_OPTS[@]}" HEAD
    else
      git diff "${DIFF_OPTS[@]}"
    fi
    hash_untracked
    hash_hidden_tracked
    hash_submodules
  } | sha256sum | awk '{print $1}'
}

# Tree of every tracked file's current content, built in a throwaway index so the real one is
# untouched. Unlike `git stash create`, this works when intent-to-add entries exist.
snapshot_tree() {
  local tmp idx tree
  tmp="$(git rev-parse --absolute-git-dir)/bs-review-index.$$"
  idx="$(git rev-parse --path-format=absolute --git-path index)"
  rm -f "$tmp"
  if [ -f "$idx" ]; then
    cp "$idx" "$tmp" || return 1
  fi
  if GIT_INDEX_FILE="$tmp" git add -u >/dev/null 2>&1 && tree="$(GIT_INDEX_FILE="$tmp" git write-tree 2>/dev/null)"; then
    rm -f "$tmp"
    printf '%s\n' "$tree"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

case "$CMD" in
  begin)
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "$REPO_ROOT"
    STATE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/bs-review-state.XXXXXX")"
    trap 'rm -rf "$STATE_DIR"' EXIT
    compute_snapshot "$REPO_ROOT" > "$STATE_DIR/pre_snapshot"
    if PRE_TREE="$(snapshot_tree)"; then
      : > "$STATE_DIR/pre_tree_exact"
    else
      echo "Warning: could not snapshot the pre-review tree (unmerged entries?); undo hints will be unavailable." >&2
      if git rev-parse --verify --quiet HEAD >/dev/null; then
        PRE_TREE="$(git rev-parse HEAD)"
      else
        PRE_TREE="$(git hash-object -t tree /dev/null)"
      fi
    fi
    printf '%s\n' "$PRE_TREE" > "$STATE_DIR/pre_tree"
    git -c core.quotePath=false ls-files --others --exclude-standard > "$STATE_DIR/untracked"
    hash_untracked > "$STATE_DIR/untracked_hashes"
    git diff "${DIFF_OPTS[@]}" --cached > "$STATE_DIR/pre_index.patch"
    trap - EXIT
    printf '%s\n' "$STATE_DIR"
    ;;

  untracked)
    [ $# -eq 1 ] || usage
    STATE_DIR="$1"
    if [ -s "$STATE_DIR/untracked" ]; then
      cat "$STATE_DIR/untracked"
    else
      echo "none"
    fi
    ;;

  verify)
    [ $# -eq 1 ] || usage
    STATE_DIR="$1"
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    cd "$REPO_ROOT"
    PRE_SNAP="$(cat "$STATE_DIR/pre_snapshot")"
    POST_SNAP="$(compute_snapshot "$REPO_ROOT")"
    if [ "$PRE_SNAP" = "$POST_SNAP" ]; then
      exit 0
    fi

    PRE_TREE="$(cat "$STATE_DIR/pre_tree")"
    echo "### Reviewer Side Effects"
    echo ""

    listed=0
    changed_tracked="$(git -c core.quotePath=false diff --no-ext-diff --no-textconv --name-only "$PRE_TREE" || true)"
    if [ -n "$changed_tracked" ]; then
      listed=1
      if [ -e "$STATE_DIR/pre_tree_exact" ]; then
        echo "**Changed tracked files** (undo with \`git restore --source=$PRE_TREE --worktree -- <path>\`):"
      else
        echo "**Changed tracked files** (may include your own pre-review edits; the pre-review tree could not be captured, so there is no undo hint):"
      fi
      while IFS= read -r p; do
        [ -n "$p" ] && printf -- '- `%s`\n' "$p"
      done <<< "$changed_tracked"
      echo ""
    fi

    new_untracked="$(git -c core.quotePath=false ls-files --others --exclude-standard | grep -vxFf "$STATE_DIR/untracked" || true)"
    if [ -n "$new_untracked" ]; then
      listed=1
      echo "**New untracked files** (undo with \`rm -- <path>\`):"
      while IFS= read -r p; do
        [ -n "$p" ] && printf -- '- `%s`\n' "$p"
      done <<< "$new_untracked"
      echo ""
    fi

    if [ -s "$STATE_DIR/untracked_hashes" ]; then
      changed_untracked=""
      while IFS=$'\t' read -r old_sig p; do
        [ -n "$p" ] || continue
        cur_line="$(hash_entry "$p")"
        if [ "$cur_line" != "${old_sig}"$'\t'"${p}" ]; then
          changed_untracked+="${p}"$'\n'
        fi
      done < "$STATE_DIR/untracked_hashes"
      if [ -n "$changed_untracked" ]; then
        listed=1
        echo "**Pre-existing untracked files modified or removed** (cannot be undone automatically):"
        while IFS= read -r p; do
          [ -n "$p" ] && printf -- '- `%s`\n' "$p"
        done <<< "$changed_untracked"
        echo ""
      fi
    fi

    if ! git diff "${DIFF_OPTS[@]}" --cached | cmp -s - "$STATE_DIR/pre_index.patch"; then
      listed=1
      echo "**Index (staged) changes detected** (cannot be undone automatically)."
      echo ""
    fi
    if [ "$listed" -eq 0 ]; then
      echo "**Changes that git's diff does not show** (files with a clean filter, assume-unchanged or skip-worktree entries, mode-only changes, or changes inside submodules); inspect them by hand."
      echo ""
    fi
    exit 1
    ;;

  cleanup)
    [ $# -eq 1 ] || usage
    STATE_DIR="$1"
    case "$(basename "$STATE_DIR")" in
      bs-review-state.*) rm -rf "$STATE_DIR" ;;
      *)
        echo "Error: refusing to delete unexpected path: $STATE_DIR" >&2
        exit 1
        ;;
    esac
    ;;

  *)
    usage
    ;;
esac
