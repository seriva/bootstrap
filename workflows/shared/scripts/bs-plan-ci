#!/usr/bin/env bash
set -euo pipefail

# Plan-branch CI for /bs-exec: the ci.yml workflow_dispatch run for the pushed plan branch
# HEAD (origin/<branch>), dispatching one when there is none. Never writes the working tree.

usage() {
  cat >&2 <<'EOF'
Usage: bs-plan-ci [--wait] <plan-branch>
Prints one line for the run of .github/workflows/ci.yml at origin/<plan-branch>:
  pass | pending | fail <url>  that run's result (cancelled runs are ignored)
  dispatched                   no run yet: started one
  recheck                      no run yet, previous run failed: nothing started; rerun with --wait
  unavailable                  no origin/<plan-branch>, or its ci.yml has no workflow_dispatch:
--wait: start a run if none (once), poll until listed, watch it, print pass or fail <url>
  (or "fail registration-timeout" / "fail cancelled" if it never shows up / is cancelled)
Exit: 0 ok, 2 usage, 3 gh failed
EOF
  exit 2
}

wait=false
[ "${1:-}" = --wait ] && { wait=true; shift; }
[ $# -eq 1 ] && [ -n "$1" ] || usage
branch="$1" interval="${BS_PLAN_CI_POLL_INTERVAL:-5}" limit="${BS_PLAN_CI_POLL_LIMIT:-24}"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "bs-plan-ci: not inside a git work tree" >&2; exit 2; }

if ! head="$(git rev-parse -q --verify "refs/remotes/origin/$branch^{commit}")" \
  || ! git show "$head:.github/workflows/ci.yml" 2>/dev/null | grep -qE '^[[:space:]]*workflow_dispatch:'; then
  echo unavailable; exit 0
fi
# Sets run_* to the newest non-cancelled run for HEAD (run_id empty: none) and prev_failed when
# the newest non-cancelled run for an older commit did not succeed.
find_runs() {
  local list id sha status conclusion url
  list="$(gh run list --workflow ci.yml --branch "$branch" --event workflow_dispatch --limit 5 \
    --json databaseId,headSha,status,conclusion,url \
    --jq '.[] | "\(.databaseId)|\(.headSha)|\(.status)|\(.conclusion)|\(.url)"')" || exit 3
  run_id="" run_status="" run_conclusion="" run_url="" prev_failed="" prev_seen=false
  while IFS='|' read -r id sha status conclusion url; do
    [ -n "$id" ] && [ "$conclusion" != cancelled ] || continue
    if [ "$sha" = "$head" ]; then
      [ -n "$run_id" ] || { run_id="$id" run_status="$status" run_conclusion="$conclusion" run_url="$url"; }
    elif ! $prev_seen; then
      prev_seen=true
      if [ "$status" = completed ] && [ "$conclusion" != success ]; then prev_failed=true; fi
    fi
  done <<EOF
$list
EOF
}
find_runs
if [ -z "$run_id" ]; then
  if ! $wait && [ -n "$prev_failed" ]; then echo recheck; exit 0; fi
  gh workflow run ci.yml --ref "$branch" >/dev/null || exit 3
  $wait || { echo dispatched; exit 0; }
  polls=0; while [ -z "$run_id" ]; do
    [ $((polls += 1)) -le "$limit" ] || { echo "fail registration-timeout"; exit 0; }
    sleep "$interval"
    find_runs
  done
fi
if $wait && [ "$run_status" != completed ]; then
  gh run watch "$run_id" --exit-status >/dev/null 2>&1 || true
  find_runs; [ -n "$run_id" ] || { echo "fail cancelled"; exit 0; }
fi
if [ "$run_status" != completed ]; then echo pending
elif [ "$run_conclusion" = success ]; then echo pass
else echo "fail $run_url"
fi
