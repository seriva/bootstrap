#!/usr/bin/env bash
set -euo pipefail

# Resolve provider, dispatch mechanism, model, effort, and unavailable-model policy for a bs-*
# orchestrated role (implementer, phase-implementer, fixer, reviewer) under T3 Code (delegate_task).
# Never touches the repo or git state.

usage() {
  cat >&2 <<'EOF'
Usage: bs-resolve-role --host <provider> --role <role> [options]
  --host <provider>          Host provider: claude, agy, codex, or host
  --host-model <model>       Active session model (optional; reused for same-provider roles and skips redundant fix escalation)
  --role <role>              implementer | phase-implementer | fixer | reviewer
  --pairing                  Enable cross-provider pairing (reviewer != implementer)
  --implementer <provider>   Explicit implementer provider (claude|agy|codex|host)
  --reviewer <provider>      Explicit reviewer provider (claude|agy|codex|host)
  --implementer-model <m>    Explicit model flag for implementer / phase-implementer / fixer
  --reviewer-model <m>       Explicit model flag for reviewer
  --has-delegate             Orchestrator delegate_task is available
  --reachable <csv>          Providers reachable via delegate_task (implies --has-delegate)
Prints KEY=value lines: PROVIDER, VIA, MODEL, EFFORT, ON_UNAVAILABLE, NOTE.
  VIA            delegate_task | pending-review
  ON_UNAVAILABLE stop | pending-review | fallback:delegate_task:<model>
Exit: 0 ok, 2 usage, 3 role requires T3 Code (delegate_task) or requested provider is unreachable.
On a non-zero exit, the last stderr line is "next: <action>" for the caller.
EOF
  echo "next: fix the call (bs-resolve-role --host <provider> --role <role> ...), then retry" >&2
  exit 2
}

die() {
  local code="$1" msg="$2" next="$3"
  echo "bs-resolve-role: $msg" >&2
  echo "next: $next" >&2
  exit "$code"
}

# Rendered by install.sh; when run directly from the source repo, load sibling models.env instead.
_m_claude="{{BS_MODEL_CLAUDE}}"
_m_agy="{{BS_MODEL_AGY}}"
_m_codex="{{BS_MODEL_CODEX}}"
_f_claude="{{BS_FIX_MODEL_CLAUDE}}"
_f_agy="{{BS_FIX_MODEL_AGY}}"
_f_codex="{{BS_FIX_MODEL_CODEX}}"
case "$_m_claude" in
  '{{'*)
    _models_file="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/models.env"
    # shellcheck disable=SC1090
    source "$_models_file"
    _m_claude="$BS_MODEL_CLAUDE"
    _m_agy="$BS_MODEL_AGY"
    _m_codex="$BS_MODEL_CODEX"
    _f_claude="${BS_FIX_MODEL_CLAUDE:-none}"
    _f_agy="${BS_FIX_MODEL_AGY:-none}"
    _f_codex="${BS_FIX_MODEL_CODEX:-none}"
    ;;
esac
if [ -n "${BS_MODELS_ENV:-}" ]; then
  [ -f "$BS_MODELS_ENV" ] || die 2 "BS_MODELS_ENV not found: $BS_MODELS_ENV" "fix BS_MODELS_ENV path and retry"
  BS_MODEL_CLAUDE="$_m_claude" BS_MODEL_AGY="$_m_agy" BS_MODEL_CODEX="$_m_codex"
  BS_FIX_MODEL_CLAUDE="$_f_claude" BS_FIX_MODEL_AGY="$_f_agy" BS_FIX_MODEL_CODEX="$_f_codex"
  # shellcheck disable=SC1090
  source "$BS_MODELS_ENV"
  _m_claude="$BS_MODEL_CLAUDE"
  _m_agy="$BS_MODEL_AGY"
  _m_codex="$BS_MODEL_CODEX"
  _f_claude="${BS_FIX_MODEL_CLAUDE:-none}"
  _f_agy="${BS_FIX_MODEL_AGY:-none}"
  _f_codex="${BS_FIX_MODEL_CODEX:-none}"
fi

host="" host_model="" role="" pairing=false
imp_flag="" rev_flag="" imp_model="" rev_model=""
has_delegate=false reachable_csv=""

while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ $# -ge 2 ] || usage; host="$2"; shift 2 ;;
    --host-model) [ $# -ge 2 ] || usage; host_model="$2"; shift 2 ;;
    --role) [ $# -ge 2 ] || usage; role="$2"; shift 2 ;;
    --pairing) pairing=true; shift ;;
    --implementer) [ $# -ge 2 ] || usage; imp_flag="$2"; shift 2 ;;
    --reviewer) [ $# -ge 2 ] || usage; rev_flag="$2"; shift 2 ;;
    --implementer-model) [ $# -ge 2 ] || usage; imp_model="$2"; shift 2 ;;
    --reviewer-model) [ $# -ge 2 ] || usage; rev_model="$2"; shift 2 ;;
    --has-delegate) has_delegate=true; shift ;;
    --reachable) [ $# -ge 2 ] || usage; reachable_csv="$2"; [ -z "$2" ] || has_delegate=true; shift 2 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
done

valid_provider() {
  case "$1" in claude | agy | codex | host) return 0 ;; *) return 1 ;; esac
}

[ -n "$host" ] && valid_provider "$host" || usage
case "$role" in implementer | phase-implementer | fixer | reviewer) ;; *) usage ;; esac
[ -z "$imp_flag" ] || valid_provider "$imp_flag" || usage
[ -z "$rev_flag" ] || valid_provider "$rev_flag" || usage

resolve_provider_alias() {
  if [ "$1" = host ]; then printf '%s' "$host"; else printf '%s' "$1"; fi
}

delegate_reaches() {
  local p="$1" item
  [ "$has_delegate" = true ] || return 1
  if [ -z "$reachable_csv" ]; then
    case "$p" in claude | agy | codex) return 0 ;; *) return 1 ;; esac
  fi
  IFS=',' read -ra _items <<< "$reachable_csv"
  for item in "${_items[@]}"; do
    item="${item//[[:space:]]/}"
    [ "$item" = "$p" ] && return 0
  done
  return 1
}

default_model_of() {
  case "$1" in
    claude) printf '%s' "$_m_claude" ;;
    agy) printf '%s' "$_m_agy" ;;
    codex) printf '%s' "$_m_codex" ;;
    *) printf '%s' "none" ;;
  esac
}

fix_model_of() {
  case "$1" in
    claude) printf '%s' "$_f_claude" ;;
    agy) printf '%s' "$_f_agy" ;;
    codex) printf '%s' "$_f_codex" ;;
    *) printf '%s' "none" ;;
  esac
}

notes=()
add_note() { [ -z "$1" ] || notes+=("$1"); }

emit() {
  local note="none" i
  if [ "${#notes[@]}" -gt 0 ]; then
    note="${notes[0]}"
    for ((i = 1; i < ${#notes[@]}; i++)); do
      note+="; ${notes[i]}"
    done
  fi
  printf 'PROVIDER=%s\nVIA=%s\nMODEL=%s\nEFFORT=%s\nON_UNAVAILABLE=%s\nNOTE=%s\n' \
    "$1" "$2" "$3" "$4" "$5" "$note"
}

# 1. Resolve IMPLEMENTER and REVIEWER providers.
if [ -n "$imp_flag" ]; then
  implementer="$(resolve_provider_alias "$imp_flag")"
else
  implementer="$host"
fi

if [ -n "$rev_flag" ]; then
  reviewer="$(resolve_provider_alias "$rev_flag")"
elif [ "$pairing" = true ] || [ -n "$imp_flag" ]; then
  reviewer=""
  for cand in claude agy codex; do
    [ "$cand" != "$implementer" ] || continue
    if delegate_reaches "$cand"; then
      reviewer="$cand"; break
    fi
  done
  if [ -z "$reviewer" ]; then
    reviewer="$implementer"
    if [ "$role" = reviewer ] && [ "$has_delegate" = true ]; then
      add_note "no other provider reachable for pairing; reviewing with $reviewer"
    fi
  fi
else
  reviewer="$host"
fi

# 2. Pick provider, explicit model flag, and unavailable policy for this role.
case "$role" in
  implementer | phase-implementer | fixer)
    provider="$implementer"
    flag_model="$imp_model"
    explicit_provider=false
    [ -z "$imp_flag" ] || explicit_provider=true
    fail_policy="stop"
    ;;
  reviewer)
    provider="$reviewer"
    flag_model="$rev_model"
    explicit_provider=false
    [ -z "$rev_flag" ] || explicit_provider=true
    fail_policy="pending-review"
    ;;
esac

# 3. Orchestrated roles require T3 Code (delegate_task).
if [ "$has_delegate" != true ]; then
  if [ "$role" = reviewer ] && [ "$explicit_provider" = false ]; then
    add_note "orchestrated review requires T3 Code (delegate_task); report PENDING_REVIEW"
    emit "$provider" "pending-review" "none" "none" "pending-review"
    exit 0
  fi
  die 3 "orchestrated role '$role' requires T3 Code (delegate_task)" \
    "stop and report that orchestrated workflows require T3 Code (delegate_task); use /bs-task or /bs-probe for local inline work"
fi

if ! delegate_reaches "$provider"; then
  if [ "$role" = reviewer ] && [ "$explicit_provider" = false ]; then
    add_note "$provider is not reachable via delegate_task; report PENDING_REVIEW"
    emit "$provider" "pending-review" "none" "none" "pending-review"
    exit 0
  fi
  die 3 "$provider is not reachable via delegate_task" \
    "stop and report that $provider is unavailable via delegate_task; never substitute another provider silently"
fi

# 4. Resolve model and effort for delegate_task.
if [ "$role" = reviewer ] || [ "$role" = fixer ]; then
  effort="high"
else
  effort="medium"
fi

if [ "$provider" = "$host" ] && [ -n "$host_model" ]; then
  normal_model="$host_model"
else
  normal_model="$(default_model_of "$provider")"
fi

if [ -n "$flag_model" ]; then
  model="$flag_model"
  on_unavailable="$fail_policy"
elif [ "$role" = fixer ]; then
  fix_model="$(fix_model_of "$provider")"
  if [ "$fix_model" != none ] && [ -n "$fix_model" ] && [ "$normal_model" != "$fix_model" ]; then
    model="$fix_model"
    on_unavailable="fallback:delegate_task:$normal_model"
    add_note "escalating Defect Fixer to $fix_model"
  else
    model="$normal_model"
    on_unavailable="stop"
  fi
else
  model="$normal_model"
  on_unavailable="$fail_policy"
fi

emit "$provider" "delegate_task" "$model" "$effort" "$on_unavailable"
