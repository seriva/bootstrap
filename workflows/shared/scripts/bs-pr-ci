#!/usr/bin/env bash
set -euo pipefail

# PR CI wait for /bs-loop and /bs-exec: watches the checks of a branch's PR, riding out the window
# after a push in which GitHub has not registered any check runs yet. Never writes the working tree.

usage() {
  cat >&2 <<'EOF'
Usage: bs-pr-ci <branch>
Watches the checks of <branch>'s PR (gh pr checks --watch --fail-fast) and prints one line:
  pass                  every check finished without failing, and at least one ran
  skipped               every check was skipped (e.g. an `if:` excludes this branch): CI did
                        not test this PR
  fail <check>,...      the failing (or cancelled) checks
  conflict              no checks reported and the PR conflicts with its base branch
                        (GitHub runs no pull_request workflows for an unmergeable PR)
  none-configured       GitHub reports no checks; when .github/workflows/ exists, only after
                        BS_PR_CI_POLL_LIMIT (3) retries BS_PR_CI_POLL_INTERVAL (10) seconds apart
Any other gh failure (e.g. a transient GraphQL, HTTP, or network error) is retried the same
way; "no pull requests found" is not.
Exit: 0 ok, 2 usage or not a repo, 3 gh failed after its retries (e.g. no PR for <branch>).
On a non-zero exit, the last stderr line is "next: <action>" for the caller.
EOF
  exit 2
}
trap 'rc=$?; case "$rc" in
  2) echo "next: fix the call (bs-pr-ci <branch>, inside the repo), then retry" >&2 ;;
  3) echo "next: treat it as BLOCKED_BY_CI with the gh error above (e.g. no PR for the branch)" >&2 ;;
esac' EXIT

[ $# -eq 1 ] && [ -n "$1" ] || usage
case "$1" in -*) usage ;; esac
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "bs-pr-ci: not inside a git work tree" >&2; exit 2; }
branch="$1" interval="${BS_PR_CI_POLL_INTERVAL:-10}" limit="${BS_PR_CI_POLL_LIMIT:-3}"
has_workflows=false
[ -d "$(git rev-parse --show-toplevel)/.github/workflows" ] && has_workflows=true

# checks_list: "<bucket>\t<name>" per check (empty if gh cannot list them).
checks_list() { gh pr checks "$branch" --json name,bucket --jq '.[] | "\(.bucket)\t\(.name)"' 2>/dev/null || true; }

retries=0 gh_retries=0
while :; do
  rc=0
  out="$(gh pr checks "$branch" --watch --fail-fast 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    list="$(checks_list)"
    if [ -n "$list" ] && ! printf '%s\n' "$list" | awk -F '\t' '$1 != "skipping" { ran = 1 } END { exit !ran }'; then
      echo skipped
    else
      echo pass
    fi
    exit 0
  fi
  case "$out" in
    *"no checks reported"*)
      mergeable="$(gh pr view "$branch" --json mergeable --jq '"\(.mergeable)"' 2>/dev/null || true)"
      if [ "$mergeable" = CONFLICTING ]; then echo conflict; exit 0; fi
      if $has_workflows && [ "$retries" -lt "$limit" ]; then
        retries=$((retries + 1))
        sleep "$interval"
        continue
      fi
      echo none-configured
      exit 0 ;;
  esac
  list="$(checks_list)"
  failed="$(printf '%s\n' "$list" | awk -F '\t' '$1 == "fail" || $1 == "cancel" { print $2 }' | paste -sd, -)"
  if [ -n "$failed" ]; then echo "fail $failed"; exit 0; fi
  # gh itself failed. A missing PR stays missing; anything else may be transient.
  case "$out" in
    *"no pull requests found"*) ;;
    *)
      if [ "$gh_retries" -lt "$limit" ]; then
        gh_retries=$((gh_retries + 1))
        sleep "$interval"
        continue
      fi ;;
  esac
  printf '%s\n' "$out" >&2
  exit 3
done
