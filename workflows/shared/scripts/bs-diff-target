#!/usr/bin/env bash
set -euo pipefail

# What /bs-review reviews: the base, diff command, work dir, and new files for the workspace, a
# branch or range, or a PR. Never writes the working tree; a PR target fetches its refs and checks
# the PR out in a temporary worktree outside the repo via bs-worktree (removed again with `cleanup`).

usage() {
  cat >&2 <<'EOF'
Usage: bs-diff-target [<branch> | <base>...<head> | #<N> | <PR URL>]
       bs-diff-target cleanup <pr-workdir> <N>
Prints "KEY value" lines: BASE, DIFF (command to run in WORKDIR), WORKDIR, optional NOTE and PR,
then UNTRACKED per new file to read in full ("UNTRACKED none" if there are none).
  (no target)    the workspace: merge-base with origin/<default> (else <default>) on another
                 branch, with @{upstream} (else HEAD) on the default branch; one diff covers
                 commits and uncommitted edits. Nothing to review: the last commit, with
                 "NOTE last-commit" (a root commit diffs against the empty tree)
  <branch>       git diff <branch>...HEAD           <base>...<head>: git diff <base>...<head>
  #<N>, PR URL   the PR head in a detached worktree outside the repo, against origin/<base>
cleanup          remove that worktree (never the main checkout) and refs/bs-review/pr-<N>
Exit: 0 ok, 2 usage, not a repo, no commits, unknown ref, 3 gh, fetch, or worktree failed
EOF
  exit 2
}

[ $# -le 3 ] || usage
worktree="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bs-worktree"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "bs-diff-target: not inside a git work tree" >&2; exit 2; }
top="$(git rev-parse --show-toplevel)"
cd "$top"
has() { git rev-parse -q --verify "$1^{commit}" >/dev/null 2>&1; }

if [ "${1:-}" = cleanup ]; then
  [ $# -eq 3 ] || usage
  "$worktree" remove "$2"
  git update-ref -d "refs/bs-review/pr-$3" 2>/dev/null || true
  exit 0
fi
[ $# -le 1 ] || usage
has HEAD || { echo "bs-diff-target: no commits yet" >&2; exit 2; }
target="${1:-}"

case "$target" in
  '#'[0-9]* | http*://*/pull/[0-9]*)
    n="$(printf '%s' "$target" | sed -e 's/^#//' -e 's|.*/pull/\([0-9][0-9]*\).*|\1|')"
    case "$n" in '' | *[!0-9]*) usage ;; esac
    case "$target" in '#'*) pr="$n" ;; *) pr="$target" ;; esac
    info="$(gh pr view "$pr" --json baseRefName,headRefOid --jq '"\(.baseRefName) \(.headRefOid)"')" || exit 3
    base="${info%% *}" head="${info##* }"
    git fetch -q origin "$base" "+refs/pull/$n/head:refs/bs-review/pr-$n" || exit 3
    wt="$("$worktree" add "$head" "review-pr-$n")" || exit 3
    printf 'BASE origin/%s\nDIFF git diff origin/%s...HEAD\nWORKDIR %s\nPR %s\nUNTRACKED none\n' \
      "$base" "$base" "$wt" "$n"
    exit 0 ;;
  *...*)
    has "${target%%...*}" && has "${target#*...}" || { echo "bs-diff-target: unknown range: $target" >&2; exit 2; }
    printf 'BASE %s\nDIFF git diff %s\nWORKDIR %s\nUNTRACKED none\n' "${target%%...*}" "$target" "$top"
    exit 0 ;;
  ?*)
    has "$target" || { echo "bs-diff-target: unknown branch: $target" >&2; exit 2; }
    printf 'BASE %s\nDIFF git diff %s...HEAD\nWORKDIR %s\nUNTRACKED none\n' "$target" "$target" "$top"
    exit 0 ;;
esac

current="$(git rev-parse --abbrev-ref HEAD)"
default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || true
for b in main master; do
  [ -z "$default" ] && { has "refs/heads/$b" || has "refs/remotes/origin/$b"; } && default="$b"
done
if [ -n "$default" ] && [ "$current" != "$default" ]; then
  if has "refs/remotes/origin/$default"; then ref="origin/$default"; else ref="$default"; fi
elif has '@{upstream}'; then ref='@{upstream}'
else ref=HEAD
fi
has "$ref" || ref=HEAD
base="$(git merge-base "$ref" HEAD)"
untracked="$(git -c core.quotePath=false ls-files --others --exclude-standard)"

if [ -z "$untracked" ] && git diff --quiet "$base"; then
  if has HEAD~1; then base="$(git rev-parse HEAD~1)"; else base="$(git hash-object -t tree /dev/null)"; fi
  printf 'BASE %s\nDIFF git diff %s HEAD\nWORKDIR %s\nNOTE last-commit\n' "$base" "$base" "$top"
else
  printf 'BASE %s\nDIFF git diff %s\nWORKDIR %s\n' "$base" "$base" "$top"
fi
if [ -n "$untracked" ]; then printf '%s\n' "$untracked" | sed 's/^/UNTRACKED /'; else echo "UNTRACKED none"; fi
