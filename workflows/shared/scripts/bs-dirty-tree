#!/usr/bin/env bash
set -euo pipefail

# Helper for protecting pre-existing uncommitted edits during bs-task / bs-loop Safe commit.
# Commands: record | has-dirty | is-dirty <path> | check-mixed <path>... | set-aside | restore | cleanup

usage() {
  cat >&2 <<'EOF'
Usage: bs-dirty-tree <command> [args...]
  record               Snapshot pre-existing tracked/untracked dirty paths (no-op if clean)
  has-dirty            Exit 0 if pre-existing dirty paths were recorded, 1 otherwise
  is-dirty <path>      Exit 0 if <path> is in recorded dirty paths, 1 otherwise
  check-mixed <path>.. Print any <path> in recorded dirty paths; exit 1 if any match
  set-aside            Back up recorded dirty edits and restore them to HEAD for gate runs
  restore              Restore backed-up dirty edits to recorded paths (saves anything changed since set-aside; safe to re-run)
  cleanup              Remove recorded dirty-tree state (refuses if backups still exist)
EOF
  exit 2
}

[ $# -ge 1 ] || usage
CMD="$1"
shift

CALLER_PWD="$(pwd -P)"
REPO_ROOT="$(cd "$(git rev-parse --show-toplevel)" && pwd -P)"
GIT_DIR="$(git rev-parse --absolute-git-dir)"
STATE_DIR="$GIT_DIR/bs-pre-dirty"

# Unquote a git C-quoted path ("caf\303\251.txt") into raw UTF-8 text.
unquote_git_path() {
  local s="$1"
  if [[ "$s" == \"*\" && ${#s} -ge 2 ]]; then
    local inner="${s:1:${#s}-2}" out="" i=0 ch nxt oct
    local len=${#inner}
    while (( i < len )); do
      ch="${inner:i:1}"
      if [[ "$ch" == '\' && $((i + 1)) -lt len ]]; then
        nxt="${inner:i+1:1}"
        case "$nxt" in
          [0-7])
            if (( i + 3 < len )) && [[ "${inner:i+1:3}" =~ ^[0-7]{3}$ ]]; then
              oct="${inner:i+1:3}"
              printf -v oct '%b' "\\0$oct"
              out+="$oct"
              i=$((i + 4))
              continue
            fi
            ;;
          '"') out+='"'; i=$((i + 2)); continue ;;
          '\') out+='\'; i=$((i + 2)); continue ;;
          a) out+=$'\a'; i=$((i + 2)); continue ;;
          b) out+=$'\b'; i=$((i + 2)); continue ;;
          f) out+=$'\f'; i=$((i + 2)); continue ;;
          n) out+=$'\n'; i=$((i + 2)); continue ;;
          r) out+=$'\r'; i=$((i + 2)); continue ;;
          t) out+=$'\t'; i=$((i + 2)); continue ;;
          v) out+=$'\v'; i=$((i + 2)); continue ;;
        esac
      fi
      out+="$ch"
      i=$((i + 1))
    done
    printf '%s' "$out"
  else
    printf '%s' "$s"
  fi
}

# Lexically normalize a path (collapse //, ., and ..).
norm_lexical() {
  local path="$1" is_abs=0
  [[ "$path" == /* ]] && is_abs=1
  local IFS='/'
  local -a raw_parts=() parts=()
  read -r -a raw_parts <<< "$path"
  local seg
  for seg in "${raw_parts[@]}"; do
    case "$seg" in
      ''|'.') continue ;;
      '..')
        if (( ${#parts[@]} > 0 )) && [[ "${parts[${#parts[@]}-1]}" != '..' ]]; then
          unset 'parts[${#parts[@]}-1]'
          parts=("${parts[@]+"${parts[@]}"}")
        elif (( is_abs == 0 )); then
          parts+=('..')
        fi
        ;;
      *) parts+=("$seg") ;;
    esac
  done
  local joined=""
  if (( ${#parts[@]} > 0 )); then
    joined="$(IFS='/'; printf '%s' "${parts[*]}")"
  fi
  if (( is_abs == 1 )); then
    printf '/%s' "$joined"
  else
    printf '%s' "${joined:-.}"
  fi
}

# Resolve symlinks on the parent directory of an absolute path when it exists.
resolve_abs_physical() {
  local p="$1" dir base
  dir="$(dirname -- "$p")"
  base="$(basename -- "$p")"
  if [ -d "$dir" ]; then
    dir="$(cd "$dir" && pwd -P)"
    norm_lexical "$dir/$base"
  else
    norm_lexical "$p"
  fi
}

# Returns: 0 = found, 1 = not found, 2 = unreadable state file (fail closed).
path_in_nul_file() {
  local needle="$1" file="$2" entry
  if [ ! -e "$file" ]; then
    return 1
  fi
  if [ ! -r "$file" ]; then
    echo "Error: cannot read dirty-tree state file: $file" >&2
    return 2
  fi
  [ -s "$file" ] || return 1
  while IFS= read -r -d '' entry; do
    if [ "$entry" = "$needle" ]; then
      return 0
    fi
  done < "$file"
  return 1
}

is_dirty_path() {
  local raw_path="$1" p cand abs_p rc
  [ -d "$STATE_DIR" ] || return 1
  p="$(unquote_git_path "$raw_path")"

  local -a candidates=()
  if [[ "$p" == /* ]]; then
    abs_p="$(resolve_abs_physical "$p")"
    if [[ "$abs_p" == "$REPO_ROOT/"* ]]; then
      candidates+=("${abs_p#"$REPO_ROOT/"}")
    fi
  elif [ "$CALLER_PWD" = "$REPO_ROOT" ]; then
    candidates+=("$(norm_lexical "$p")")
  else
    abs_p="$(resolve_abs_physical "$CALLER_PWD/$p")"
    if [[ "$abs_p" == "$REPO_ROOT/"* ]]; then
      candidates+=("${abs_p#"$REPO_ROOT/"}")
    fi
    # Only fall back to repo-root-relative if the path does not exist relative to CALLER_PWD
    if [ ! -e "$CALLER_PWD/$p" ] && [ ! -L "$CALLER_PWD/$p" ]; then
      candidates+=("$(norm_lexical "$p")")
    fi
  fi

  for cand in "${candidates[@]}"; do
    rc=0
    path_in_nul_file "$cand" "$STATE_DIR/tracked" || rc=$?
    if (( rc == 0 )); then return 0; fi
    if (( rc != 1 )); then return "$rc"; fi

    rc=0
    path_in_nul_file "$cand" "$STATE_DIR/untracked" || rc=$?
    if (( rc == 0 )); then return 0; fi
    if (( rc != 1 )); then return "$rc"; fi
  done
  return 1
}

SAVE_DIR="$GIT_DIR/bs-dirty-tree-saves"

# How backups are kept exact:
# - The index is backed up as a patch built with plumbing plus explicit options, so user diff
#   config (diff.external, textconv, noprefix, color, renames) cannot change it, and it is applied
#   with `apply --cached` (index only, no worktree conversion) with apply.* config overridden.
# - The working tree is backed up as a raw tarball of every recorded path that exists, so clean/
#   smudge filters, eol conversion, core.fileMode and assume-unchanged/skip-worktree bits cannot
#   hide bytes from it. Submodule worktrees are never touched, so gitlinks are left out.
PATCH_OPTS=(-p --binary --no-ext-diff --no-textconv --no-color --no-renames --src-prefix=a/ --dst-prefix=b/ --ignore-submodules=dirty)
APPLY=(git -c apply.whitespace=nowarn -c apply.ignoreWhitespace=no apply)

# Files that make up a backup; any of them present means a restore is still pending.
backups_exist() {
  [ -e "$STATE_DIR/index.patch" ] || [ -e "$STATE_DIR/worktree.tar" ] \
    || [ -e "$STATE_DIR/worktree.patch" ] || [ -e "$STATE_DIR/untracked.tar" ]
}

BACKUP_FILES=(index.patch worktree.tar worktree.patch untracked.tar base ita flags.assume flags.skip
  wt_tracked wt_paths existing absent post.fp post.index)

remove_backup_files() {
  local f
  for f in "${BACKUP_FILES[@]}"; do
    rm -f "$STATE_DIR/$f" || return 1
  done
}

# True when the nearest ancestor directory of a repo-relative path is writable. Ancestors that
# are missing or are not directories (e.g. a recorded file that replaced a directory) are skipped.
parent_writable() {
  local d
  d="$(dirname -- "${1%/}")"
  while { [ ! -d "$d" ] || [ -L "$d" ]; } && [ "$d" != "." ] && [ "$d" != "/" ]; do
    d="$(dirname -- "$d")"
  done
  [ -d "$d" ] && [ -w "$d" ]
}

# The commit the index backup is relative to: HEAD when set-aside ran.
base_commit() {
  if [ -s "$STATE_DIR/base" ]; then
    cat "$STATE_DIR/base"
  else
    git rev-parse --verify HEAD
  fi
}

# True when <path> is a submodule gitlink in the index or in <base>.
is_gitlink() {
  local p="$1" base="$2" line
  if IFS= read -r -d '' line < <(git --literal-pathspecs ls-files -s -z -- "$p"); then
    [ "${line%% *}" = 160000 ] && [ "${line#*$'\t'}" = "$p" ] && return 0
  fi
  if [ -n "$base" ] && IFS= read -r -d '' line < <(git --literal-pathspecs ls-tree -z "$base" -- "$p"); then
    [ "${line%% *}" = 160000 ] && [ "${line#*$'\t'}" = "$p" ] && return 0
  fi
  return 1
}

# Split the recorded paths into the ones whose working tree this script manages (wt_tracked:
# tracked minus gitlinks; wt_paths: wt_tracked plus untracked).
build_wt_lists() {
  local base="$1" p
  : > "$STATE_DIR/wt_tracked" || return 1
  while IFS= read -r -d '' p; do
    is_gitlink "$p" "$base" || printf '%s\0' "$p" >> "$STATE_DIR/wt_tracked" || return 1
  done < "$STATE_DIR/tracked"
  cat "$STATE_DIR/wt_tracked" "$STATE_DIR/untracked" > "$STATE_DIR/wt_paths"
}

# Raw fingerprint of one working-tree entry (content, exec bit, symlink target).
fp_entry() {
  local p="$1"
  if [ -L "$p" ]; then
    printf 'l:%s' "$(readlink -- "$p")"
  elif [ -f "$p" ]; then
    printf 'f%s:%s' "$([ -x "$p" ] && printf x)" "$(sha256sum < "$p" | cut -d' ' -f1)"
  elif [ -d "$p" ]; then
    printf 'd'
  elif [ -e "$p" ]; then
    printf 'o'
  else
    printf 'absent'
  fi
}

# Raw fingerprint of a recorded path; directories are fingerprinted recursively.
fp_path() {
  local p="$1" f
  if [ -d "$p" ] && [ ! -L "$p" ]; then
    printf 'd:%s' "$(find "./$p" -print0 | LC_ALL=C sort -z | while IFS= read -r -d '' f; do
      printf '%s\0%s\0' "$f" "$(fp_entry "$f")"
    done | sha256sum | cut -d' ' -f1)"
  else
    fp_entry "$p"
  fi
}

# Fingerprints of every wt_paths entry, NUL-separated, in list order.
write_fps() {
  local out="$1" p
  : > "$out" || return 1
  while IFS= read -r -d '' p; do
    printf '%s\0' "$(fp_path "$p")" >> "$out" || return 1
  done < "$STATE_DIR/wt_paths"
}

# Fingerprint of the index entries at every recorded path (tracked or untracked at record time).
index_fp() {
  cat "$STATE_DIR/tracked" "$STATE_DIR/untracked" \
    | xargs -0 -r git --literal-pathspecs ls-files -s -z -- | sha256sum | cut -d' ' -f1
}

# Set the index entries of every recorded tracked path to <base>. Plumbing only: no sparse-
# checkout checks and no working-tree access, so it is safe to repeat.
reset_index_to_base() {
  local base="$1"
  [ -s "$STATE_DIR/tracked" ] || return 0
  git update-index -z --force-remove --stdin < "$STATE_DIR/tracked" || return 1
  xargs -0 -r git --literal-pathspecs ls-tree -r -z --full-tree "$base" -- < "$STATE_DIR/tracked" \
    | git update-index -z --index-info
}

# Make the working tree of every path in <list> match the index: remove what is there, then
# check out the paths the index has. Callers must have backed those paths up first.
reset_worktree_to_index() {
  local list="$1" present="$STATE_DIR/present" p
  : > "$present" || return 1
  while IFS= read -r -d '' p; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -rf -- "$p" || return 1
    fi
    if git rev-parse --verify --quiet ":0:$p" >/dev/null; then
      printf '%s\0' "$p" >> "$present" || return 1
    fi
  done < "$list"
  if [ -s "$present" ]; then
    git checkout-index -f -u -z --stdin < "$present" || return 1
  fi
  rm -f "$present"
}

# Remove every path in <list> that exists now.
remove_paths() {
  local p
  while IFS= read -r -d '' p; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -rf -- "$p" || return 1
    fi
  done < "$1"
}

# Before restore overwrites recorded paths, save what is there now if it changed since
# set-aside (e.g. work done after an interrupted run): the index as a commit under
# refs/bs-dirty-tree/, and the raw content of every changed recorded path as a tarball.
# Without set-aside's fingerprints (older state), everything that exists is saved.
save_before_restore() {
  local keep="$STATE_DIR/restore.keep" p cur old have_post=0 idx_changed=0 ts ref tree commit
  if [ -f "$STATE_DIR/post.fp" ] && [ -f "$STATE_DIR/post.index" ]; then
    have_post=1
  fi
  : > "$keep" || return 1
  [ "$have_post" -eq 0 ] || exec 3< "$STATE_DIR/post.fp"
  while IFS= read -r -d '' p; do
    old="?"
    if [ "$have_post" -eq 1 ]; then
      IFS= read -r -d '' old <&3 || old="?"
    fi
    cur="$(fp_path "$p")"
    if [ "$cur" != absent ] && [ "$cur" != "$old" ]; then
      printf '%s\0' "$p" >> "$keep" || return 1
    fi
  done < "$STATE_DIR/wt_paths"
  [ "$have_post" -eq 0 ] || exec 3<&-
  if [ "$have_post" -eq 1 ]; then
    [ "$(index_fp)" = "$(cat "$STATE_DIR/post.index")" ] || idx_changed=1
  elif [ -s "$STATE_DIR/tracked" ] && git rev-parse --verify --quiet HEAD >/dev/null; then
    [ -z "$(xargs -0 -r git --literal-pathspecs diff-index --cached --ita-invisible-in-index --name-only --no-renames HEAD -- < "$STATE_DIR/tracked")" ] || idx_changed=1
  fi
  ts="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  ref="refs/bs-dirty-tree/before-restore-$ts"
  if [ "$idx_changed" -eq 1 ]; then
    # write-tree (not `git stash create`) so intent-to-add entries do not block the save.
    if ! tree="$(git write-tree)"; then
      echo "Error: cannot snapshot the index before restore (unmerged entries?); nothing was modified. Resolve them and re-run restore." >&2
      return 1
    fi
    commit="$(git -c user.name=bs-dirty-tree -c user.email=bs-dirty-tree@localhost commit-tree --no-gpg-sign -p HEAD -m "bs-dirty-tree: index before restore" "$tree")" || return 1
    git update-ref -m "bs-dirty-tree: index before restore" "$ref" "$commit" || return 1
    echo "Note: saved the staged content as it was before restore in $ref (recover a file's staged version with: git restore --staged --source=$ref -- <path>)." >&2
  fi
  if [ -s "$keep" ]; then
    mkdir -p "$SAVE_DIR" && tar --null -cf "$SAVE_DIR/before-restore-$ts.tar" -T "$keep" || return 1
    echo "Note: saved the working-tree content of recorded paths as it was before restore in $SAVE_DIR/before-restore-$ts.tar (recover with: tar -C \"$REPO_ROOT\" -xpf \"$SAVE_DIR/before-restore-$ts.tar\" <path>)." >&2
  fi
  rm -f "$keep"
}

# Re-apply assume-unchanged / skip-worktree bits recorded at set-aside.
restore_flags() {
  local p
  if [ -s "$STATE_DIR/flags.assume" ]; then
    while IFS= read -r -d '' p; do
      git rev-parse --verify --quiet ":0:$p" >/dev/null || continue
      git --literal-pathspecs update-index --assume-unchanged -- "$p" || return 1
    done < "$STATE_DIR/flags.assume"
  fi
  if [ -s "$STATE_DIR/flags.skip" ]; then
    while IFS= read -r -d '' p; do
      git rev-parse --verify --quiet ":0:$p" >/dev/null || continue
      git --literal-pathspecs update-index --skip-worktree -- "$p" || return 1
    done < "$STATE_DIR/flags.skip"
  fi
}

case "$CMD" in
  record)
    cd "$REPO_ROOT"
    if ! mkdir "$STATE_DIR" 2>/dev/null; then
      echo "Error: $STATE_DIR already exists; it may hold a backup of uncommitted edits from an earlier failed restore." >&2
      exit 1
    fi
    if git rev-parse --verify --quiet HEAD >/dev/null; then
      { git diff --name-only --no-renames -z HEAD; git diff --cached --name-only --no-renames -z; } \
        | sort -zu > "$STATE_DIR/tracked"
    else
      git diff --cached --name-only --no-renames -z | sort -zu > "$STATE_DIR/tracked"
    fi
    git ls-files -z --others --exclude-standard > "$STATE_DIR/untracked"
    if [ ! -s "$STATE_DIR/tracked" ] && [ ! -s "$STATE_DIR/untracked" ]; then
      rm -rf "$STATE_DIR"
    fi
    ;;

  has-dirty)
    [ -d "$STATE_DIR" ]
    ;;

  is-dirty)
    [ $# -eq 1 ] || usage
    is_dirty_path "$1"
    ;;

  check-mixed)
    [ $# -ge 1 ] || usage
    mixed=0
    for p in "$@"; do
      rc=0
      is_dirty_path "$p" || rc=$?
      if (( rc == 0 )); then
        printf '%s\n' "$p"
        mixed=1
      elif (( rc != 1 )); then
        exit "$rc"
      fi
    done
    exit "$mixed"
    ;;

  set-aside)
    [ -d "$STATE_DIR" ] || exit 0
    cd "$REPO_ROOT"
    if backups_exist; then
      echo "Error: backup files already exist in $STATE_DIR; refusing to overwrite." >&2
      exit 1
    fi
    if [ -s "$STATE_DIR/tracked" ] && ! git rev-parse --verify --quiet HEAD >/dev/null; then
      echo "Error: cannot set aside staged tracked files in a repository with no commits." >&2
      exit 1
    fi

    # Clean up partial backups if anything fails before we modify the working tree
    trap 'remove_backup_files' EXIT
    base=""
    : > "$STATE_DIR/index.patch"
    : > "$STATE_DIR/ita"
    : > "$STATE_DIR/flags.assume"
    : > "$STATE_DIR/flags.skip"
    if [ -s "$STATE_DIR/tracked" ]; then
      base="$(git rev-parse --verify HEAD)"
      printf '%s\n' "$base" > "$STATE_DIR/base"
      git update-index -q --refresh >/dev/null 2>&1 || true
      # Literal pathspecs: a recorded "app/[slug].tsx" must not match a task file "app/s.tsx".
      xargs -0 -r git --literal-pathspecs diff-index --cached --ita-invisible-in-index "${PATCH_OPTS[@]}" HEAD -- < "$STATE_DIR/tracked" > "$STATE_DIR/index.patch"
      # Intent-to-add entries show up as additions in the worktree diff; re-mark them on restore.
      xargs -0 -r git --literal-pathspecs diff-files --name-only -z --no-renames --diff-filter=A -- < "$STATE_DIR/tracked" > "$STATE_DIR/ita"
      # assume-unchanged (lowercase tag) and skip-worktree (S/s) bits, re-applied on restore.
      while IFS= read -r -d '' e; do
        tag="${e%% *}"
        p="${e#* }"
        case "$tag" in [a-z]) printf '%s\0' "$p" >> "$STATE_DIR/flags.assume" ;; esac
        case "$tag" in S|s) printf '%s\0' "$p" >> "$STATE_DIR/flags.skip" ;; esac
      done < <(xargs -0 -r git --literal-pathspecs ls-files -v -z -- < "$STATE_DIR/tracked")
    fi
    build_wt_lists "$base"

    : > "$STATE_DIR/existing"
    : > "$STATE_DIR/absent"
    while IFS= read -r -d '' p; do
      if [ -e "$p" ] || [ -L "$p" ]; then
        printf '%s\0' "$p" >> "$STATE_DIR/existing"
      else
        printf '%s\0' "$p" >> "$STATE_DIR/absent"
      fi
      # Fail before touching the tree if a recorded path cannot be reset.
      if ! parent_writable "$p"; then
        echo "Error: cannot reset '$p' (parent directory not writable); nothing was modified." >&2
        exit 1
      fi
    done < "$STATE_DIR/wt_paths"
    if [ -s "$STATE_DIR/existing" ]; then
      tar --null -cf "$STATE_DIR/worktree.tar" -T "$STATE_DIR/existing"
    fi
    # Backups are complete; if the reset fails, restore automatically
    trap - EXIT

    if ! {
      { [ -z "$base" ] || reset_index_to_base "$base"; } \
        && reset_worktree_to_index "$STATE_DIR/wt_paths"
    }; then
      echo "Error: set-aside failed during working-tree reset; attempting automatic restore..." >&2
      "$0" restore || true
      exit 1
    fi
    # Fingerprints of the set-aside state let restore tell later work from its own leftovers.
    if ! { write_fps "$STATE_DIR/post.fp" && index_fp > "$STATE_DIR/post.index"; }; then
      rm -f "$STATE_DIR/post.fp" "$STATE_DIR/post.index"
    fi
    ;;

  restore)
    [ -d "$STATE_DIR" ] || exit 0
    backups_exist || exit 0
    cd "$REPO_ROOT"
    # Only recorded paths are touched: edits to other files (formatter output, later work) stay.
    base=""
    if [ -s "$STATE_DIR/tracked" ]; then
      base="$(base_commit)" || exit 1
    fi
    if [ ! -f "$STATE_DIR/wt_paths" ]; then
      build_wt_lists "$base" || exit 1
    fi
    if [ -e "$STATE_DIR/worktree.patch" ] || [ -e "$STATE_DIR/untracked.tar" ]; then
      # State written by an older version (patch-based working-tree backup).
      if ! {
        save_before_restore \
          && { [ -z "$base" ] || reset_index_to_base "$base"; } \
          && reset_worktree_to_index "$STATE_DIR/wt_tracked" \
          && { [ ! -s "$STATE_DIR/index.patch" ] || "${APPLY[@]}" --index "$STATE_DIR/index.patch"; } \
          && { [ ! -s "$STATE_DIR/worktree.patch" ] || "${APPLY[@]}" "$STATE_DIR/worktree.patch"; } \
          && { [ ! -f "$STATE_DIR/untracked.tar" ] || tar -xpf "$STATE_DIR/untracked.tar"; } \
          && { [ ! -s "$STATE_DIR/ita" ] || xargs -0 -r git --literal-pathspecs add -N -- < "$STATE_DIR/ita"; }
      }; then
        echo "Error: restore failed. User edits remain backed up in $STATE_DIR. Do NOT delete $STATE_DIR." >&2
        exit 1
      fi
    else
      if [ -s "$STATE_DIR/existing" ] && [ ! -f "$STATE_DIR/worktree.tar" ]; then
        echo "Error: $STATE_DIR/worktree.tar is missing; refusing to touch the working tree. Do NOT delete $STATE_DIR." >&2
        exit 1
      fi
      if ! {
        save_before_restore \
          && { [ -z "$base" ] || reset_index_to_base "$base"; } \
          && { [ ! -s "$STATE_DIR/index.patch" ] || "${APPLY[@]}" --cached "$STATE_DIR/index.patch"; } \
          && remove_paths "$STATE_DIR/wt_paths" \
          && { [ ! -f "$STATE_DIR/worktree.tar" ] || tar -xpf "$STATE_DIR/worktree.tar"; } \
          && { [ ! -s "$STATE_DIR/ita" ] || xargs -0 -r git --literal-pathspecs add -N -- < "$STATE_DIR/ita"; } \
          && restore_flags
      }; then
        echo "Error: restore failed. User edits remain backed up in $STATE_DIR (index.patch, worktree.tar). Do NOT delete $STATE_DIR." >&2
        exit 1
      fi
    fi
    if [ -n "$base" ] && [ "$base" != "$(git rev-parse --verify HEAD)" ]; then
      touched="$(xargs -0 -r git --literal-pathspecs diff-tree -r --name-only --no-renames "$base" HEAD -- < "$STATE_DIR/tracked")"
      if [ -n "$touched" ]; then
        printf 'Warning: the new commit also changed pre-existing dirty path(s); restored their pre-existing content, so these now differ from HEAD:\n%s\n' "$touched" >&2
      fi
    fi
    if ! remove_backup_files; then
      echo "Error: could not remove backup files from $STATE_DIR after restoring; remove them by hand only after checking your edits." >&2
      exit 1
    fi
    ;;

  cleanup)
    [ -d "$STATE_DIR" ] || exit 0
    if backups_exist; then
      echo "Error: backup files still exist in $STATE_DIR; run 'restore' first." >&2
      exit 1
    fi
    rm -rf "$STATE_DIR"
    ;;

  *)
    usage
    ;;
esac
