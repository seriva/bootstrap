#!/usr/bin/env bash
set -euo pipefail

# Review-run state of a branch's PR for the bs-* skills, from one `gh pr view` call, and the
# writer of the Gate line /bs-loop records (`set`), so reader and writer share these markers.
# Never writes the working tree.
PLACEHOLDER='*Automated AI review & fix cycle in progress...*'
FIX_SUBJECT_SUFFIX=': address review feedback'
GATE_MARKER='**Gate:**'

usage() {
  cat >&2 <<'EOF'
Usage: bs-review-state <branch>
       bs-review-state set <branch> <GATE> <detail> [<report-file>]
Prints "<state> <base-branch>", or "none" when the branch has no PR. <state> is the first match:
  merged | closed        the PR is merged or closed (gh may return one for a reused branch name)
  ready                  open and not a draft
  in-review | fix-used   draft whose Review Status is still the placeholder; fix-used once a
                         commit subject ends in ": address review feedback" (the one Fix Turn)
  gated:<GATE>           draft whose first Gate line starts with PASSED, BLOCKED_BY_DEFECTS,
                         or BLOCKED_BY_CI (later Gate lines, e.g. quoted in the report, are ignored)
  draft                  any other draft
set writes "**Gate:** <GATE> (<detail>)", GATE one of PASSED, BLOCKED_BY_DEFECTS, BLOCKED_BY_CI:
  while the body has the placeholder, the line holding it becomes "## Review Status", the
  Gate line, and <report-file>'s contents (required then; e.g. Findings and probe details);
  afterwards it replaces the first Gate line (no <report-file>). Then prints the new state.
Exit: 0 ok, 2 usage, 3 gh failed, 4 (set) PR body has neither the placeholder nor a Gate line
EOF
  exit 2
}

err="$(mktemp "${TMPDIR:-/tmp}/bs-review-state.XXXXXX")"
body_file="$(mktemp "${TMPDIR:-/tmp}/bs-review-state.body.XXXXXX")"
trap 'rm -f "$err" "$body_file"' EXIT

if [ "${1:-}" = set ]; then
  [ $# -ge 4 ] && [ $# -le 5 ] && [ -n "$2" ] && [ -n "$4" ] || usage
  branch="$2" gate="$3" detail="$4" report="${5:-}"
  case "$gate" in PASSED | BLOCKED_BY_DEFECTS | BLOCKED_BY_CI) ;; *) usage ;; esac
  [ -z "$report" ] || [ -f "$report" ] || { echo "bs-review-state: no such report file: $report" >&2; exit 2; }
  if ! body="$(gh pr view "$branch" --json body --jq '"\(.body)"' 2>"$err")"; then
    cat "$err" >&2
    exit 3
  fi
  line="$GATE_MARKER $gate ($detail)"
  if printf '%s\n' "$body" | grep -qF -- "$PLACEHOLDER"; then
    [ -n "$report" ] || { echo "bs-review-state: set needs a <report-file> to replace the placeholder" >&2; exit 2; }
    printf '%s\n' "$body" | PH="$PLACEHOLDER" LINE="$line" REPORT="$report" awk '
      !done && index($0, ENVIRON["PH"]) {
        if (!seen_heading || $0 ~ /^##[[:space:]]+Review Status/) {
          print "## Review Status"; print ""
        }
        print ENVIRON["LINE"]; print ""
        while ((getline r < ENVIRON["REPORT"]) > 0) print r
        done = 1; next
      }
      /^##[[:space:]]+Review Status[[:space:]]*$/ { seen_heading = 1 }
      { print }' > "$body_file"
  elif printf '%s\n' "$body" | grep -qE '\*\*Gate(:\*\*|\*\*:)'; then
    [ -z "$report" ] || { echo "bs-review-state: <report-file> only replaces the placeholder" >&2; exit 2; }
    printf '%s\n' "$body" | LINE="$line" awk '
      !done && /\*\*Gate(:\*\*|\*\*:)/ { print ENVIRON["LINE"]; done = 1; next }
      { print }' > "$body_file"
  else
    echo "bs-review-state: PR body for $branch has neither the review placeholder nor a Gate line" >&2
    exit 4
  fi
  if ! gh pr edit "$branch" --body-file "$body_file" >/dev/null 2>"$err"; then
    cat "$err" >&2
    exit 3
  fi
  rm -f "$err" "$body_file"
  exec "$0" "$branch"
fi

[ $# -eq 1 ] && [ -n "$1" ] || usage

# First line: state, isDraft, baseRefName, number of fix commits (tab-separated); then the body.
jq_record="\"\(.state)\t\(.isDraft)\t\(.baseRefName)\t\([.commits[].messageHeadline | select(endswith(\"$FIX_SUBJECT_SUFFIX\"))] | length)\n\(.body)\""
if ! record="$(gh pr view "$1" --json state,isDraft,baseRefName,body,commits --jq "$jq_record" 2>"$err")"; then
  if grep -q 'no pull requests found' "$err"; then echo none; exit 0; fi
  cat "$err" >&2
  exit 3
fi

IFS="$(printf '\t')" read -r state draft base fixes <<EOF
$(printf '%s\n' "$record" | head -n 1)
EOF
body="$(printf '%s\n' "$record" | sed 1d)"
# Only the first Gate line counts: it is the one `set` writes and rewrites, ahead of the report,
# whose Findings or probe output may quote other Gate lines.
gate="$(printf '%s\n' "$body" | sed -nE 's/.*\*\*Gate(:\*\*|\*\*:)[[:space:]]*([A-Z_]+).*/\2/p' | head -n 1)"

if [ "$state" = MERGED ]; then s=merged
elif [ "$state" = CLOSED ]; then s=closed
elif [ "$draft" != true ]; then s=ready
elif printf '%s\n' "$body" | grep -qF -- "$PLACEHOLDER"; then
  if [ "${fixes:-0}" -gt 0 ]; then s=fix-used; else s=in-review; fi
else
  case "$gate" in PASSED | BLOCKED_BY_DEFECTS | BLOCKED_BY_CI) s="gated:$gate" ;; *) s=draft ;; esac
fi
echo "$s $base"
