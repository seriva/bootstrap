#!/usr/bin/env bash
set -euo pipefail

# Read-only snapshot of the working tree for the bs-* skills.
# Never writes the working tree or the object store, and never changes index content;
# `git diff` may still refresh the index's cached file stat data.
# Paths are always repo-root-relative, whatever directory it is called from.

usage() {
  cat >&2 <<'EOF'
Usage: bs-tree-state <command>
  hash                    One hash of the working-tree state: status, diffs, and
                          untracked file contents, exec bits, and symlink targets
  dirty                   Paths already dirty (modified, staged, or untracked), sorted
  baseline -- <path>...   "<blob-sha|missing|non-file> <path>" per path, in order,
                          then "staged <sha>" for the staged diff of those paths
EOF
  exit 2
}

[ $# -ge 1 ] || usage
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "bs-tree-state: not inside a git work tree" >&2; exit 2; }
cd "$(git rev-parse --show-toplevel)"
# Keep `git status` from taking the index lock to refresh it (`git diff` may still refresh it).
export GIT_OPTIONAL_LOCKS=0

# Unstaged changes: against HEAD, or against the index when there is no commit yet.
worktree_diff() {
  if git rev-parse -q --verify HEAD >/dev/null; then git "$@" HEAD; else git "$@"; fi
}

cmd="$1"
shift
case "$cmd" in
  hash)
    [ $# -eq 0 ] || usage
    {
      git status --porcelain --untracked-files=all
      worktree_diff diff
      git diff --cached
      # Untracked files by content and exec bit, including files inside untracked nested repos.
      # Untracked symlinks by target: `-type f` skips them, and status only lists their path.
      git ls-files --others --exclude-standard -z | xargs -0 sh -c 'for f; do
        find "./$f" -type f -not -path "*/.git/*" -print -exec git hash-object --no-filters {} \;
        find "./$f" -type f -perm -u+x -not -path "*/.git/*"
        find "./$f" -type l -not -path "*/.git/*" -print -exec readlink {} \;
      done' _
    } | git hash-object --stdin
    ;;
  dirty)
    [ $# -eq 0 ] || usage
    {
      worktree_diff -c core.quotePath=false diff --name-only --no-renames
      git -c core.quotePath=false diff --cached --name-only --no-renames
      git -c core.quotePath=false ls-files --others --exclude-standard
    } | LC_ALL=C sort -u
    ;;
  baseline)
    [ "${1:-}" = "--" ] && shift
    [ $# -ge 1 ] || usage
    for p in "$@"; do
      if [ -f "$p" ]; then
        printf '%s %s\n' "$(git hash-object --no-filters -- "$p")" "$p"
      elif [ -e "$p" ] || [ -L "$p" ]; then
        printf 'non-file %s\n' "$p"
      else
        printf 'missing %s\n' "$p"
      fi
    done
    printf 'staged %s\n' "$(git --literal-pathspecs diff --cached --no-renames -- "$@" | git hash-object --stdin)"
    ;;
  *) usage ;;
esac
