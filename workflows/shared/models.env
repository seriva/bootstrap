# Default paired and fix-escalation models for bs-* workflows.
# Override locally without modifying this repo by creating:
#   ${XDG_CONFIG_HOME:-$HOME/.config}/bootstrap/models.env
# then re-running ./install.sh.
BS_MODEL_CLAUDE="claude-sonnet-5-5"
BS_MODEL_AGY="gemini-4-hydrogen"
BS_MODEL_CODEX="gpt-6.1-terra"

# Escalation models for Defect Fixer (empty disables fix-turn escalation).
BS_FIX_MODEL_CLAUDE="claude-opus-5-5"
BS_FIX_MODEL_AGY="gemini-4-neon"
BS_FIX_MODEL_CODEX="gpt-6.2-sol"
