#!/usr/bin/env python3
"""semsearch: hybrid (meaning + keyword) code search over the current git repository.

Indexes the repo into SQLite (FTS5 keyword index + embedding vectors from an
OpenAI-compatible server such as LM Studio) and answers queries with the best
matching code chunks as `path:start-end`. Stdlib only.

Environment:
  SEMSEARCH_API_BASE      e.g. http://192.168.100.10:1234/v1 (unset: keyword search only)
  SEMSEARCH_EMBED_MODEL   default text-embedding-nomic-embed-text-v1.5@f16
  SEMSEARCH_RERANK_MODEL  e.g. qwen3-reranker-0.6b (empty: no reranking)
  SEMSEARCH_CACHE         default ~/.cache/semsearch
  SEMSEARCH_INDEX_BUDGET  seconds of embedding per query run, default 20

Endpoint problems never fail the command: it prints a hint and exits 0.
"""

import argparse
import array
import ast
import hashlib
import http.client
import json
import math
import os
import re
import socket
import sqlite3
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

SCHEMA_VERSION = "1"
DIMS = 256  # nomic-embed-text-v1.5 is Matryoshka-trained: the first 256 dims keep most quality
BATCH = 32
MAX_FILE_BYTES = 1_000_000
MAX_CHUNK_LINES = 60
WINDOW_LINES = 40
UNAVAILABLE = "semsearch: embedding endpoint unavailable, use rg"
DENSE_TOP = 20  # stage 1 dense candidates
KEYWORD_TOP = 10  # stage 1 BM25 candidates
MAX_CANDIDATES = 25
RRF_K = 60
SNIPPET_LINES = 20
RERANK_TOP = 10  # ~190 ms per pair on the target GPU, serialised: 10 pairs ~ 2 s
RERANK_LINES = 20
RERANK_DEADLINE = 4.0
RERANK_PAIR_TIMEOUT = 2.0

PREFLIGHT_TIMEOUT = 0.4
QUERY_EMBED_TIMEOUT = 3.0
BATCH_EMBED_TIMEOUT = 15.0

LOCKFILES = re.compile(r"(^|/)(package-lock\.json|npm-shrinkwrap\.json|yarn\.lock|pnpm-lock\.yaml|go\.sum|Cargo\.lock|poetry\.lock)$")
MINIFIED = re.compile(r"\.min\.(js|css|mjs)$|\.map$")

JS_EXT = {".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".mts", ".cts"}
HEADER_PATTERNS = {
    "js": [
        re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)"),
        re.compile(r"^\s*(?:export\s+)?(?:default\s+)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)"),
        re.compile(r"^\s*(?:export\s+)?(?:const|let|var)\s+([A-Za-z_$][\w$]*)\s*=\s*(?:async\s+)?(?:\([^)]*\)|[A-Za-z_$][\w$]*)\s*=>"),
        re.compile(r"^\s*(?:export\s+)?(?:interface|type|enum)\s+([A-Za-z_$][\w$]*)"),
    ],
    "go": [
        re.compile(r"^func\s+(?:\([^)]*\)\s*)?([A-Za-z_]\w*)"),
        re.compile(r"^type\s+([A-Za-z_]\w*)"),
    ],
    "bash": [
        re.compile(r"^\s*function\s+([\w:.-]+)"),
        re.compile(r"^\s*([\w:.-]+)\s*\(\)\s*\{?"),
    ],
}


class EndpointError(Exception):
    """The embedding/rerank server is unreachable or answered with something unusable."""


# --------------------------------------------------------------------------- config & git

class Config:
    def __init__(self, env=None):
        env = os.environ if env is None else env
        self.api_base = env.get("SEMSEARCH_API_BASE", "").strip().rstrip("/")
        self.embed_model = env.get("SEMSEARCH_EMBED_MODEL", "").strip() or "text-embedding-nomic-embed-text-v1.5@f16"
        self.rerank_model = env.get("SEMSEARCH_RERANK_MODEL", "").strip()
        self.cache = os.path.expanduser(env.get("SEMSEARCH_CACHE", "").strip() or "~/.cache/semsearch")
        try:
            self.index_budget = float(env.get("SEMSEARCH_INDEX_BUDGET", "") or 20)
        except ValueError:
            self.index_budget = 20.0


def repo_root(cwd):
    try:
        out = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return None
    return out or None


def list_files(root):
    """Repo-root-relative paths of tracked + untracked-not-ignored files, whatever the cwd."""
    out = subprocess.run(["git", "-C", root, "ls-files", "-z", "-c", "-o", "--exclude-standard"],
                         capture_output=True, check=True).stdout
    paths = sorted({p for p in out.decode("utf-8", "surrogateescape").split("\0") if p})
    # ls-files -c still lists tracked files deleted from the work tree
    return [p for p in paths if os.path.isfile(os.path.join(root, p)) and not os.path.islink(os.path.join(root, p))]


# --------------------------------------------------------------------------- chunking

def indexable(path, data):
    if len(data) > MAX_FILE_BYTES or b"\0" in data[:8192]:
        return False
    if LOCKFILES.search(path) or MINIFIED.search(path):
        return False
    lines = data.count(b"\n") + 1
    return len(data) / lines <= 300  # minified / generated bundles are a few giant lines


def language(path, text):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".py":
        return "python"
    if ext in JS_EXT:
        return "js"
    if ext == ".go":
        return "go"
    if ext in (".sh", ".bash") or re.match(r"#!.*\b(ba)?sh\b", text[:100]):
        return "bash"
    return None


def python_headers(text):
    """(line, symbol) for top-level defs/classes and methods of top-level classes, decorators included."""
    tree = ast.parse(text)
    defs = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
    headers = []
    for node in tree.body:
        if isinstance(node, defs):
            headers.append((min([node.lineno] + [d.lineno for d in node.decorator_list]), node.name))
            if isinstance(node, ast.ClassDef):
                for sub in node.body:
                    if isinstance(sub, (ast.FunctionDef, ast.AsyncFunctionDef)):
                        start = min([sub.lineno] + [d.lineno for d in sub.decorator_list])
                        headers.append((start, f"{node.name}.{sub.name}"))
    return headers


def regex_headers(lines, lang):
    headers = []
    for i, line in enumerate(lines, 1):
        for pat in HEADER_PATTERNS[lang]:
            m = pat.match(line)
            if m:
                headers.append((i, m.group(1)))
                break
    return headers


def chunk_file(path, text):
    """Split a file into (start, end, symbol, text) chunks; lines are 1-based and inclusive."""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if not lines:
        return []
    lang = language(path, text)
    headers = []
    if lang == "python":
        try:
            headers = python_headers(text)
        except (SyntaxError, ValueError):
            headers = []
    elif lang:
        headers = regex_headers(lines, lang)

    if headers:
        headers = sorted(dict(headers).items())  # one symbol per start line
        segments = []
        if headers[0][0] > 1:
            segments.append((1, headers[0][0] - 1, ""))
        for idx, (start, symbol) in enumerate(headers):
            end = headers[idx + 1][0] - 1 if idx + 1 < len(headers) else len(lines)
            segments.append((start, end, symbol))
        max_lines = MAX_CHUNK_LINES
    else:
        segments = [(1, len(lines), "")]
        max_lines = WINDOW_LINES

    chunks = []
    for start, end, symbol in segments:
        for s in range(start, end + 1, max_lines):
            e = min(s + max_lines - 1, end)
            body = "\n".join(lines[s - 1:e])
            if body.strip():
                chunks.append((s, e, symbol, body))
    return chunks


# --------------------------------------------------------------------------- vectors

def normalise(vec):
    vec = list(vec[:DIMS])
    norm = math.sqrt(sum(v * v for v in vec)) or 1.0
    return [v / norm for v in vec]


def pack(vec):
    return array.array("f", vec).tobytes()


def unpack(blob):
    return array.array("f", blob)


# --------------------------------------------------------------------------- reranker request

RERANK_SYSTEM = ('Judge whether the Document meets the requirements based on the Query and the Instruct provided. '
                 'Note that the answer can only be "yes" or "no".')
RERANK_INSTRUCT = "Given a code search query, retrieve relevant code"


def rerank_request(model, query, document):
    """Qwen3-Reranker as a yes/no judge over /v1/chat/completions.

    Verified against LM Studio on 2026-11-04 (LM Studio build on busybox; probed via its
    OpenAI-compatible API) with qwen3-reranker-0.6b Q8_0:
      * /v1/rerank does not exist: LM Studio answers HTTP 200 + {"error": "Unexpected endpoint..."}.
      * /v1/completions returns logprobs: null, so it cannot score.
      * This exact shape works: the trailing assistant message is continued, not wrapped in a
        new turn, so the first generated token is "yes"/"No". Without the "<think>\\n\\n</think>\\n\\n"
        prefill the first token is junk ("immer", ":\\n"). max_tokens 1 returns logprobs: null,
        so 2 is required. Relevant code scored 0.95-0.999, irrelevant 0.000.
    If a server or chat-template update breaks this, rerank_score() sees no yes/no token and
    search() falls back to the RRF order instead of mis-ranking.
    """
    return {
        "model": model,
        "temperature": 0,
        "max_tokens": 2,
        "logprobs": True,
        "top_logprobs": 10,
        "messages": [
            {"role": "system", "content": RERANK_SYSTEM},
            {"role": "user", "content": f"<Instruct>: {RERANK_INSTRUCT}\n<Query>: {query}\n<Document>: {document}"},
            {"role": "assistant", "content": "<think>\n\n</think>\n\n"},
        ],
    }


# --------------------------------------------------------------------------- endpoint client

class Client:
    def __init__(self, cfg):
        self.cfg = cfg

    def preflight(self):
        """Fast TCP check so an offline server costs <500 ms instead of a long read timeout."""
        url = urllib.parse.urlparse(self.cfg.api_base)
        if url.scheme not in ("http", "https") or not url.hostname:
            raise EndpointError("bad SEMSEARCH_API_BASE")
        port = url.port or (443 if url.scheme == "https" else 80)
        try:
            socket.create_connection((url.hostname, port), timeout=PREFLIGHT_TIMEOUT).close()
        except OSError as e:
            raise EndpointError(str(e)) from e

    def post(self, path, body, timeout):
        req = urllib.request.Request(self.cfg.api_base + path, json.dumps(body).encode(),
                                     {"Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.load(resp)
        except (OSError, ValueError, urllib.error.URLError, http.client.HTTPException) as e:  # timeouts are OSError
            raise EndpointError(str(e)) from e
        if not isinstance(data, dict) or "error" in data:  # LM Studio answers unknown routes with 200 + error
            raise EndpointError(f"server error: {data!r:.200}")
        return data

    def rerank_score(self, query, document, timeout):
        """P(yes) that `document` answers `query`, from the reranker's first-token logprobs."""
        data = self.post("/chat/completions", rerank_request(self.cfg.rerank_model, query, document), timeout)
        try:
            top = data["choices"][0]["logprobs"]["content"][0]["top_logprobs"]
        except (KeyError, IndexError, TypeError) as e:  # logprobs: null when the server ignores the request
            raise EndpointError(f"no logprobs in rerank response: {e}") from e
        yes = sum(math.exp(t["logprob"]) for t in top if t.get("token", "").strip().lower() == "yes")
        no = sum(math.exp(t["logprob"]) for t in top if t.get("token", "").strip().lower() == "no")
        if yes + no == 0:  # model did not answer yes/no first: prompt format broke, don't trust the order
            raise EndpointError("rerank answer is not yes/no")
        return yes / (yes + no)

    def embed(self, texts, timeout):
        data = self.post("/embeddings", {"model": self.cfg.embed_model, "input": texts}, timeout)
        try:
            rows = sorted(data["data"], key=lambda d: d.get("index", 0))
            vecs = [normalise(r["embedding"]) for r in rows]
        except (KeyError, TypeError) as e:
            raise EndpointError(f"bad embeddings response: {e}") from e
        if len(vecs) != len(texts) or any(len(v) < DIMS for v in vecs):
            raise EndpointError("embeddings response has wrong shape")
        return vecs


# --------------------------------------------------------------------------- index store

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY, mtime REAL, size INTEGER, sha TEXT);
CREATE TABLE IF NOT EXISTS chunks(id INTEGER PRIMARY KEY, path TEXT, start INTEGER, end INTEGER,
                                  symbol TEXT, text TEXT, vec BLOB);
CREATE INDEX IF NOT EXISTS chunks_path ON chunks(path);
CREATE INDEX IF NOT EXISTS chunks_pending ON chunks(id) WHERE vec IS NULL;
CREATE VIRTUAL TABLE IF NOT EXISTS chunks_fts USING fts5(text, symbol, path);
"""


def db_path(cfg, root):
    return os.path.join(cfg.cache, hashlib.sha1(root.encode()).hexdigest() + ".db")


def remove_db(path):
    for suffix in ("", "-wal", "-shm"):
        try:
            os.remove(path + suffix)
        except FileNotFoundError:
            pass


def connect(path, model):
    con = sqlite3.connect(path, timeout=5)
    con.execute("PRAGMA busy_timeout=5000")
    con.execute("PRAGMA journal_mode=WAL")
    con.executescript(SCHEMA)
    meta = dict(con.execute("SELECT key, value FROM meta"))
    want = {"schema": SCHEMA_VERSION, "model": model, "dims": str(DIMS)}
    if not meta:
        con.executemany("INSERT INTO meta VALUES (?, ?)", want.items())
        con.commit()
    elif meta != want:
        raise sqlite3.DatabaseError("index built with a different schema or model")
    return con


def open_db(cfg, root, rebuild=False):
    """Open the repo's index; a corrupt, outdated, or other-model index is deleted and rebuilt."""
    os.makedirs(cfg.cache, exist_ok=True)
    path = db_path(cfg, root)
    if rebuild:
        remove_db(path)
    try:
        return connect(path, cfg.embed_model)
    except sqlite3.DatabaseError:
        remove_db(path)
        return connect(path, cfg.embed_model)


def delete_path(con, path):
    ids = [r[0] for r in con.execute("SELECT id FROM chunks WHERE path = ?", (path,))]
    con.executemany("DELETE FROM chunks_fts WHERE rowid = ?", [(i,) for i in ids])
    con.execute("DELETE FROM chunks WHERE path = ?", (path,))


def sync_files(con, root):
    """Pass 1 (local, no network): bring chunks + FTS5 in line with the work tree; vec stays NULL."""
    current = list_files(root)
    known = {r[0]: (r[1], r[2], r[3]) for r in con.execute("SELECT path, mtime, size, sha FROM files")}
    for path in current:
        full = os.path.join(root, path)
        try:
            st = os.stat(full)
        except OSError:
            continue
        old = known.get(path)
        if old and old[0] == st.st_mtime and old[1] == st.st_size:
            continue
        with open(full, "rb") as f:
            data = f.read()
        sha = hashlib.sha1(data).hexdigest()
        if not (old and old[2] == sha):
            delete_path(con, path)
            if indexable(path, data):
                text = data.decode("utf-8", "replace")
                for start, end, symbol, body in chunk_file(path, text):
                    cur = con.execute("INSERT INTO chunks(path, start, end, symbol, text) VALUES (?, ?, ?, ?, ?)",
                                      (path, start, end, symbol, body))
                    con.execute("INSERT INTO chunks_fts(rowid, text, symbol, path) VALUES (?, ?, ?, ?)",
                                (cur.lastrowid, body, split_identifiers(symbol), path))
        con.execute("INSERT OR REPLACE INTO files VALUES (?, ?, ?, ?)", (path, st.st_mtime, st.st_size, sha))
    gone = set(known) - set(current)
    for path in gone:
        delete_path(con, path)
        con.execute("DELETE FROM files WHERE path = ?", (path,))
    con.commit()


def split_identifiers(symbol):
    """`shrinkSlice` -> `shrinkSlice shrink slice` so keyword search matches either form."""
    parts = re.findall(r"[A-Z]+(?![a-z])|[A-Z]?[a-z]+|\d+", symbol)
    return " ".join([symbol] + [p.lower() for p in parts]) if symbol else ""


def document_text(path, symbol, body):
    return f"search_document: {path} :: {symbol}\n{body}"


def embed_pending(con, client, budget):
    """Pass 2: embed chunks without vectors, committing per batch so an interrupted run resumes.

    budget: seconds (None = no limit). Returns (embedded_total, chunk_total, stopped_reason or None).
    """
    start = time.monotonic()
    reason = None
    while True:
        rows = con.execute("SELECT id, path, symbol, text FROM chunks WHERE vec IS NULL ORDER BY id LIMIT ?",
                           (BATCH,)).fetchall()
        if not rows:
            break
        if budget is not None and time.monotonic() - start >= budget:
            reason = "budget"
            break
        try:
            vecs = client.embed([document_text(p, s, t) for _, p, s, t in rows], BATCH_EMBED_TIMEOUT)
        except EndpointError:
            reason = "endpoint"
            break
        con.executemany("UPDATE chunks SET vec = ? WHERE id = ?", [(pack(v), r[0]) for v, r in zip(vecs, rows)])
        con.commit()
    done = con.execute("SELECT count(*) FROM chunks WHERE vec IS NOT NULL").fetchone()[0]
    total = con.execute("SELECT count(*) FROM chunks").fetchone()[0]
    return done, total, reason


def progress_note(done, total):
    pct = 100 * done // total if total else 100
    return f"semsearch: indexed {done}/{total} chunks ({pct}%), continuing on next query"


# --------------------------------------------------------------------------- search

def fts_query(query):
    """Quote every word: raw text in MATCH treats `-`, `.`, `:`, `NOT`, ... as FTS5 syntax and raises."""
    return " OR ".join('"' + t.replace('"', '""') + '"' for t in re.findall(r"\w+", query))


def keyword_ids(con, query, limit=KEYWORD_TOP):
    match = fts_query(query)
    if not match:
        return []
    try:
        return [r[0] for r in con.execute("SELECT rowid FROM chunks_fts WHERE chunks_fts MATCH ? ORDER BY rank LIMIT ?",
                                          (match, limit))]
    except sqlite3.OperationalError:
        return []


def vector_ids(con, qvec, limit=DENSE_TOP):
    scored = []
    for cid, blob in con.execute("SELECT id, vec FROM chunks WHERE vec IS NOT NULL"):
        vec = unpack(blob)
        scored.append((sum(a * b for a, b in zip(qvec, vec)), cid))
    scored.sort(reverse=True)
    return [cid for _, cid in scored[:limit]]


def rrf_fuse(*rankings, k=RRF_K, limit=MAX_CANDIDATES):
    """Reciprocal Rank Fusion: sum of 1/(k + rank) across rankings; returns [(id, score)] best first."""
    scores = {}
    for ranking in rankings:
        for rank, cid in enumerate(ranking, 1):
            scores[cid] = scores.get(cid, 0.0) + 1.0 / (k + rank)
    return sorted(scores.items(), key=lambda kv: (-kv[1], kv[0]))[:limit]


def rerank(client, query, candidates, rows):
    """Rescore candidates with the reranker; None (keep RRF order) on any failure or deadline.

    Sequential on purpose: LM Studio serialises requests, so threads only add overhead.
    """
    deadline = time.monotonic() + RERANK_DEADLINE
    scored = []
    for cid, _ in candidates:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return None
        _, path, _, _, _, text = rows[cid]
        document = path + "\n" + "\n".join(text.split("\n")[:RERANK_LINES])
        try:
            scored.append((client.rerank_score(query, document, min(RERANK_PAIR_TIMEOUT, remaining)), cid))
        except EndpointError:
            return None
    order = sorted(range(len(scored)), key=lambda i: (-scored[i][0], i))  # stable on RRF order for ties
    return [(scored[i][1], scored[i][0]) for i in order]


def search(con, client, query, k, fast, cfg):
    """Returns (results, mode); mode is hybrid | keyword | rerank."""
    dense = []
    if client is not None:
        try:
            qvec = client.embed(["search_query: " + query], QUERY_EMBED_TIMEOUT)[0]
            dense = vector_ids(con, qvec)
        except EndpointError:
            print(UNAVAILABLE, file=sys.stderr)
            client = None
    fused = rrf_fuse(dense, keyword_ids(con, query))
    mode = "hybrid" if client is not None else "keyword"
    ranked = [(cid, score) for cid, score in fused]
    rows = {r[0]: r for r in con.execute(
        f"SELECT id, path, start, end, symbol, text FROM chunks WHERE id IN ({','.join('?' * len(ranked))})",
        [cid for cid, _ in ranked])} if ranked else {}
    if client is not None and cfg.rerank_model and not fast and ranked:
        reranked = rerank(client, query, ranked[:RERANK_TOP], rows)
        if reranked is not None:
            ranked = reranked + ranked[RERANK_TOP:]
            mode = "rerank"
    results = []
    for cid, score in ranked[:k]:
        _, path, start, end, symbol, text = rows[cid]
        results.append({"path": path, "start": start, "end": end, "symbol": symbol,
                        "score": round(score, 4), "text": text})
    return results, mode


def print_results(results, mode, as_json):
    if as_json:
        print(json.dumps({"mode": mode, "results": results}, indent=2))
        return
    if not results:
        print("no matches")
        return
    for i, r in enumerate(results):
        if i:
            print()
        print(f"{r['path']}:{r['start']}-{r['end']}  {r['score']:.3f}  {r['symbol']}".rstrip())
        lines = r["text"].split("\n")
        for line in lines[:SNIPPET_LINES]:
            print("    " + line)
        if len(lines) > SNIPPET_LINES:
            print(f"    … {len(lines) - SNIPPET_LINES} more lines")


# --------------------------------------------------------------------------- main

def parse_args(argv):
    p = argparse.ArgumentParser(prog="semsearch", description="Hybrid meaning + keyword code search for the current git repo.")
    p.add_argument("query", nargs="*", help="what to look for, in words or identifiers")
    p.add_argument("-k", type=int, default=5, help="number of results (default 5)")
    p.add_argument("--fast", action="store_true", help="skip reranking")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--index", action="store_true", help="embed the whole repo now, with no time budget")
    p.add_argument("--reindex", action="store_true", help="delete and rebuild this repo's index")
    args = p.parse_args(argv)
    if not args.query and not (args.index or args.reindex):
        p.error("a query is required (or --index / --reindex)")
    return args


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    root = repo_root(os.getcwd())
    if not root:
        print("semsearch: not a git repository", file=sys.stderr)
        return 2
    cfg = Config()
    con = open_db(cfg, root, rebuild=args.reindex)
    sync_files(con, root)

    client = None
    if cfg.api_base:
        client = Client(cfg)
        try:
            client.preflight()
        except EndpointError:
            client = None
    if client is None:
        print(UNAVAILABLE, file=sys.stderr)
    else:
        budget = None if (args.index or args.reindex) else cfg.index_budget
        done, total, reason = embed_pending(con, client, budget)
        if reason == "budget":
            print(progress_note(done, total), file=sys.stderr)
        elif reason == "endpoint":
            print(UNAVAILABLE, file=sys.stderr)
            client = None
        elif args.index or args.reindex:
            print(f"semsearch: indexed {done}/{total} chunks", file=sys.stderr)

    if args.query:
        results, mode = search(con, client, " ".join(args.query), max(args.k, 1), args.fast, cfg)
        print_results(results, mode, args.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())
