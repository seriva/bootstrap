# ==============================================================================
# bootstrap Agent Container Environment Configuration
# Copy this file to .env before starting the container:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# Server & Network Configuration (Customizable per deployment)
# ==============================================================================

# VS Code Web (code-server)
# Required: the IDE gives a shell with passwordless sudo and access to your API keys.
# Generate one with: openssl rand -base64 24
PASSWORD=
CODE_SERVER_HOST_PORT=8080       # Port exposed on your host machine
CODE_SERVER_PORT=8080            # Port listened inside the container
CODE_SERVER_BIND=127.0.0.1       # 127.0.0.1 for local-only, 0.0.0.0 for LAN/public
CODE_SERVER_BASE_PATH=           # Optional: subpath if behind a reverse proxy (e.g. /code)

# T3 Code Web Orchestrator
T3_HOST_PORT=8011                # Port exposed on your host machine
T3_PORT=8011                     # Port listened inside the container
T3_BIND=127.0.0.1                # 127.0.0.1 for local-only, 0.0.0.0 for LAN/public
# Public / LAN URL used when generating pairing tokens (e.g. http://my-host.lan:8011)
T3_BASE_URL=http://localhost:8011

# Worker harnesses to activate inside the container (comma-separated):
# Available options: claude, codex, opencode, pi, agy, all
# (T3 Code is always installed by default as the central orchestrator)
ENABLED_WORKERS=claude,codex,opencode

# Node.js major version baked into the image (applies on the next build)
NODE_MAJOR=24

# API Keys & Custom Endpoints (Optional)
# If left blank, you can log in interactively via `docker compose exec agent <cli> login`
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# OpenCode endpoint (e.g. for local Ollama, vLLM, or LM Studio)
OPENCODE_API_BASE=
OPENCODE_API_KEY=

# Code search for agents (`semsearch`), optional. Point it at an OpenAI-compatible server
# such as LM Studio, e.g. http://192.168.1.10:1234/v1. Left blank, semsearch only does
# keyword search and the skills fall back to rg.
SEMSEARCH_API_BASE=
# Embedding model id on that server (blank = text-embedding-nomic-embed-text-v1.5@f16)
SEMSEARCH_EMBED_MODEL=
# Optional reranker for better top results, e.g. qwen3-reranker-0.6b (blank = no reranking)
SEMSEARCH_RERANK_MODEL=

# Git Author Config (Used for commits made by agents inside the container)
GIT_USER_NAME=Agent
GIT_USER_EMAIL=agent@bootstrap.local

